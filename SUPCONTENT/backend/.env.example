NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=database
DB_PORT=5432
DB_NAME=supcontent
DB_USER=supcontent
DB_PASSWORD=change_me

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For Expo Go on a physical device, use a public HTTPS tunnel URL here and
# register the exact same URL in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Transactional email (Brevo HTTPS API)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=your_verified_sender@example.com
EMAIL_FROM_NAME=SUPMOVIES Notifications
