# Copy this file to `.env` and fill in the required values.
# Never commit `.env` or real credentials.

# Application
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=database
DB_PORT=5432
DB_NAME=supcontent
DB_USER=supcontent
DB_PASSWORD=

#admin_password
ADMIN_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# TMDB
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# SMTP email notifications
# Push/in-app notifications work without these. Email notifications require SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SUPMOVIES Notifications <notifications@example.com>
