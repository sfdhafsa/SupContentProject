# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# Environment example matching the project's `.env` keys.

# Application
PORT=3000
NODE_ENV=development

# Database (Postgres)
DB_HOST=database
DB_PORT=5432
DB_NAME=supcontent
DB_USER=supcontent
DB_PASSWORD=your_db_password_here

# JWT
# Replace with a strong secret in production
JWT_SECRET=replace_with_strong_jwt_secret
JWT_EXPIRES_IN=7d

# pgAdmin (local/dev)
PGADMIN_DEFAULT_EMAIL=admin@supcontent.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# Notes:
# - Copy this file to `.env` (in the project root) and fill real secrets.
# - Ensure `.env` and `secrets/` are listed in `.gitignore` to avoid committing secrets.
BASE_URL=http://localhost:3000

# SMTP email notifications
# Push/in-app notifications work without these. Email notifications require SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=notifications@example.com
SMTP_EHLO_DOMAIN=localhost
