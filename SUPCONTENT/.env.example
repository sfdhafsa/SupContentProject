# Copy this file to .env and fill local/development values.
# For production, prefer Docker secrets or a managed secret store.

# Postgres (non-sensitive defaults)
POSTGRES_USER= example
POSTGRES_DB=example
POSTGRES_PASSWORD=example

# Backend
PORT=example port
DB_HOST=example
DB_PORT=example
DB_NAME=example
DB_USER=example
DB_PASSWORD=example
NODE_ENV=example

# pgAdmin (local/dev)
# Set `PGADMIN_DEFAULT_EMAIL` and `PGADMIN_DEFAULT_PASSWORD` here for development.
# In production, provide credentials via Docker secrets and an entrypoint that
# injects the secret as an environment variable, or configure your orchestration
# to set these variables securely.
PGADMIN_DEFAULT_EMAIL=example
PGADMIN_DEFAULT_PASSWORD=example
