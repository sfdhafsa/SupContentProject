# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# Example development environment variables (placeholders).

# Application
PORT= port of app
NODE_ENV= environment

# JWT
# Replace with a strong secret in production
JWT_SECRET=replace_with_strong_jwt_secret
JWT_EXPIRES_IN=replace with period of expiration

# PostgreSQL (development defaults)
DB_HOST=name of db service 
DB_PORT=port of db service
DB_NAME= your db name
DB_USER=your db user
DB_PASSWORD=your db password

# pgAdmin (local/dev)
PGADMIN_DEFAULT_EMAIL= your pg email
PGADMIN_DEFAULT_PASSWORD=changeme

# Notes:
# - Copy this file to `.env` (in the project root) and fill real secrets.
# - Keep the real `.env` in your local `.gitignore` and do not commit secrets.